{
  "schemaVersion": 1,
  "purpose": "Frozen ruler for the closed-loop steering loop (PLAN-closed-loop-steering.md). Phase 1's integration tests drive a scripted mock provider through these scenarios and assert the eval-record steering fields. Do not delete; only add.",
  "evalFields": ["revisionIterations", "converged", "finalReason"],
  "scenarios": [
    {
      "id": "converge-after-feedback",
      "intent": "A conformance task whose conditional update is unmet on the first pass and satisfied after the harness steers the agent with the unmet criterion.",
      "contract": {
        "taskType": "conformance",
        "acceptanceCriteria": [
          { "id": "AC1", "shape": "conformance-inspection", "provenance": "explicit" },
          { "id": "AC2", "shape": "conditional-action", "provenance": "explicit" }
        ]
      },
      "mockProviderScript": [
        { "pass": 1, "agentDoes": "inspects only; does NOT perform the update", "assessment": { "AC1": "met", "AC2": "unmet" }, "arbiter": { "AC2": "unsatisfied" } },
        { "pass": 2, "agentDoes": "performs the update after receiving the steering feedback", "assessment": { "AC1": "met", "AC2": "met" } }
      ],
      "expect": {
        "router": ["continue (pass 1 -> pass 2)", "stop/converged (pass 2)"],
        "revisionIterations": 1,
        "converged": true,
        "finalReason": "converged",
        "overallStatus": "complete"
      }
    },
    {
      "id": "blocked-stops",
      "intent": "A task whose required tool is denied. The failure is 'blocked' and the loop must STOP and surface it, never retry the denied tool.",
      "contract": {
        "taskType": "implementation",
        "acceptanceCriteria": [
          { "id": "AC1", "shape": "ears-event", "provenance": "explicit" }
        ]
      },
      "evidenceLedger": [
        { "id": "EV1", "source": "tool", "tool": "write_file", "outcome": "denied" }
      ],
      "mockProviderScript": [
        { "pass": 1, "agentDoes": "attempts the write; it is denied", "assessment": { "AC1": "unmet" }, "arbiter": { "AC1": "blocked" } }
      ],
      "expect": {
        "router": ["stop (no further agent pass)"],
        "revisionIterations": 0,
        "converged": false,
        "finalReason": "blocked",
        "overallStatus": "incomplete"
      }
    },
    {
      "id": "budget-exhausted-honest-stop",
      "intent": "An unsatisfied criterion the agent never fixes. The loop steers up to the budget, then stops with an honest incomplete report.",
      "contract": {
        "taskType": "conformance",
        "acceptanceCriteria": [
          { "id": "AC1", "shape": "conformance-comparison", "provenance": "explicit" }
        ]
      },
      "settings": { "intentMaxCompletionRevisions": 2 },
      "mockProviderScript": [
        { "pass": 1, "assessment": { "AC1": "unmet" }, "arbiter": { "AC1": "unsatisfied" } },
        { "pass": 2, "assessment": { "AC1": "unmet" }, "arbiter": { "AC1": "unsatisfied" } },
        { "pass": 3, "assessment": { "AC1": "unmet" }, "arbiter": { "AC1": "unsatisfied" } }
      ],
      "expect": {
        "router": ["continue", "continue", "stop/budget-exhausted"],
        "revisionIterations": 2,
        "converged": false,
        "finalReason": "budget-exhausted",
        "overallStatus": "incomplete"
      }
    }
  ]
}
